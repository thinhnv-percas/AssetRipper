<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<OutputPath>..\0Bins\AssetRipper.Tools.Il2CppStructDbValidator\$(Configuration)\</OutputPath>
		<IntermediateOutputPath>..\0Bins\obj\AssetRipper.Tools.Il2CppStructDbValidator\$(Configuration)\</IntermediateOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\AssetRipper.Import\AssetRipper.Import.csproj" />
	</ItemGroup>

	<ItemGroup>
		<RuntimeHostConfigurationOption Include="System.Globalization.Invariant" Value="true" />
	</ItemGroup>

	<!--
		The IL2Cpp runtime struct layouts, copied to <output>/structdb where StructDbLocator looks.
		Gzipped: 6.4 MB rather than 62 MB, and StructDbCatalog reads either form.
	-->
	<ItemGroup>
		<Content Include="$(MSBuildThisFileDirectory)..\..\StructDb\*.json.gz;$(MSBuildThisFileDirectory)..\..\StructDb\index.json">
			<Link>structdb\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

</Project>
