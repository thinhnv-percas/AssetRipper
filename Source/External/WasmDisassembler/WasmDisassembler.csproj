<Project Sdk="Microsoft.NET.Sdk">

    <!--
        AssetRipper: vendored. Multi-targeting, packing, SourceLink and package metadata dropped;
        the single target framework comes from ../Directory.Build.props. Everything else is upstream.
    -->

    <PropertyGroup>
        <OutputPath>..\..\0Bins\Other\WasmDisassembler\$(Configuration)\</OutputPath>
        <IntermediateOutputPath>..\..\0Bins\obj\WasmDisassembler\$(Configuration)\</IntermediateOutputPath>
        <Authors>Samboy063</Authors>
        <Company>Samboy063</Company>
        <DebugType>embedded</DebugType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
        <Description>Simple, zero-dependency disassembler for WebAssembly bytecode</Description>
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

</Project>
