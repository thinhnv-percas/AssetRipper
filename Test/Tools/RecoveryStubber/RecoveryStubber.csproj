<Project Sdk="Microsoft.NET.Sdk">

  <!-- Outside AssetRipper.slnx. SandOut: replaces the body of every recovered member that does not compile with a
       stub that reports itself once, so a recovered project can be opened and played while those bodies are repaired. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RecoveryStubber</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

</Project>
