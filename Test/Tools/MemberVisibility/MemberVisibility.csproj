<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately outside AssetRipper.slnx: this is a measurement tool, not part of the product, and
       it must build without touching the product's restore graph. System.Reflection.Metadata ships in
       the shared framework, so it has no package references and restores offline. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AssetRipper.Tools.MemberVisibility</RootNamespace>
    <AssemblyName>MemberVisibility</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
