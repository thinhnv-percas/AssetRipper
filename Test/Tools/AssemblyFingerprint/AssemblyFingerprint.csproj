<Project Sdk="Microsoft.NET.Sdk">

  <!-- Outside AssetRipper.slnx, like MemberVisibility: a measurement tool with no package references,
       so it restores offline. System.Reflection.Metadata ships in the shared framework. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AssemblyFingerprint</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
