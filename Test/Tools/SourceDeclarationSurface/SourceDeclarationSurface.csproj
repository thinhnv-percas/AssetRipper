<Project Sdk="Microsoft.NET.Sdk">

  <!-- Outside AssetRipper.slnx. Iteration 063: the declaration surface of a C# source tree, so it can be
       compiled against a player build's stripped reference assemblies and fingerprinted like the build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SourceDeclarationSurface</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

</Project>
