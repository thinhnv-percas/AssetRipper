<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately outside AssetRipper.slnx: this is a measurement tool, not part of the product, and
       it must build without touching the product's restore graph. It loads assemblies reflectively
       and has no package references, so it restores offline. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AssetRipper.Tools.RuntimeEquivalence</RootNamespace>
    <AssemblyName>RuntimeEquivalence</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
