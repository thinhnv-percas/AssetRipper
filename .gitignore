**/.vs/
**/*.csproj.user
packages/
**/packages.config
obj
0Bins/
bin
*.user
.idea
**/build/
.vscode
*.blend1
launchSettings.json
.DS_Store

# The 'bin' rule above targets build output, but a ripped Android game keeps its
# metadata and asset bundles under assets/bin, so game data committed for testing
# was being dropped silently. Re-including the directory is required: git will not
# descend into an excluded one, so negating only the files has no effect.
!Test/Input/**/bin/
!Test/Input/**/obj/

# Rip output and logs from RUN-TEST.bat. Every run rewrites these, so tracking them
# means every run dirties the tree; upload the log to share it instead.
Test/Output/
Test/Output-*/

# Unpacked test games. Pinata is committed; anything else is fetched by hand.
Test/Input/RunFromZombies/
Test/AssetRipper.log
Test/*.log
Test/AssetRipper-recovery.log
Test/Input/Impostor/
Test/Input/JellyBlast/

# Agent iteration artifacts: the generated Unity projects are large and reproducible from the
# recorded commit, input hash and command. The logs and reports beside them are the record.
/iterations/*/output/
/artifacts/input/*.apk
/artifacts/input/*.ipa
/artifacts/reference/
