-        public static Type TypeOf(string guid, long fileID) => guid == BuiltinScriptGuid ? (builtinScripts.TryGetValue(fileID, out var bt) ? bt : null) : TypeOf(guid);
+        public static Type TypeOf(string guid, long fileID) => guid == BuiltinScriptGuid ? (builtinScripts.TryGetValue(fileID, out var bt) ? bt : null)
+            : TypeOf(guid) ?? DllTypeOf(guid, fileID);
+
+        // ------------------------------------------------------------------ scripts inside precompiled assemblies
+        /// <summary>Plugin DLLs under Assets by the guid of their .dll.meta, and the scripts each declares by file id.</summary>
+        static Dictionary<string, string> dllByGuid;
+        static readonly Dictionary<string, Dictionary<long, Type>> dllScripts = new();
+
+        /// <summary>A MonoBehaviour or ScriptableObject inside a precompiled assembly: the scene names it by the DLL's guid and
+        /// <see cref="DllScriptIds.FileIdOf"/> of its namespace and name, never by a .cs.meta.</summary>
+        public static Type DllTypeOf(string guid, long fileID)
+        {
+            if (guid == null) return null;
+            if (dllByGuid == null)
+            {
+                dllByGuid = new();
+                var assets = Path.Combine(AssetIndex.Root, "Assets");
+                if (Directory.Exists(assets))
+                    foreach (var meta in Directory.EnumerateFiles(assets, "*.dll.meta", SearchOption.AllDirectories))
+                        foreach (var l in File.ReadLines(meta))
+                            if (l.StartsWith("guid: ")) { dllByGuid[l.Substring(6).Trim()] = meta[..^5]; break; }
+            }
+            if (!dllByGuid.TryGetValue(guid, out var dll)) return null;
+            if (!dllScripts.TryGetValue(guid, out var byId))
+            {
+                dllScripts[guid] = byId = new();
+                System.Reflection.Assembly asm = null;
+                try { asm = System.Reflection.Assembly.Load(new System.Reflection.AssemblyName(Path.GetFileNameWithoutExtension(dll))); }
+                catch (Exception e) { Debug.LogWarning($"[MiniUnity] cannot load {Path.GetFileName(dll)}: {e.Message}"); }
+                if (asm != null)
+                {
+                    if (!TypeCache.ProjectAssemblies.Contains(asm)) TypeCache.AddProjectAssembly(asm);
+                    Type[] types;
+                    try { types = asm.GetTypes(); } catch (System.Reflection.ReflectionTypeLoadException e) { types = e.Types.Where(t => t != null).ToArray(); }
+                    foreach (var t in types)
+                    {
+                        if (t.IsGenericTypeDefinition || t.IsNested) continue;
+                        if (!(typeof(MonoBehaviour).IsAssignableFrom(t) || typeof(ScriptableObject).IsAssignableFrom(t))) continue;
+                        byId[DllScriptIds.FileIdOf(t.Namespace, t.Name)] = t;
+                    }
+                }
+            }
+            return byId.TryGetValue(fileID, out var found) ? found : null;
+        }
 
         public static YRef ScriptRef(Type t)
         {
diff --git a/Engine/Core/Compat/AudioVideoTypes.cs b/Engine/Core/Compat/AudioVideoTypes.cs
