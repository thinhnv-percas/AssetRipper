diff --git a/Engine/Core/Assets/DllScriptIds.cs b/Engine/Core/Assets/DllScriptIds.cs
new file mode 100644
index 0000000..14d5ba1
--- /dev/null
+++ b/Engine/Core/Assets/DllScriptIds.cs
@@ -0,0 +1,78 @@
+using System;
+using System.Buffers.Binary;
+using System.Text;
+
+namespace MiniUnity
+{
+    /// <summary>
+    /// The file id Unity gives a MonoBehaviour or ScriptableObject inside a precompiled assembly: the first four bytes,
+    /// little endian, of MD4("s\0\0\0" + namespace + name). A scene references such a script as (guid of the .dll.meta,
+    /// that file id), so without it every component from a plugin DLL loads as a missing script.
+    /// </summary>
+    public static class DllScriptIds
+    {
+        public static int FileIdOf(string ns, string name)
+        {
+            var text = Encoding.UTF8.GetBytes((ns ?? "") + name);
+            var input = new byte[4 + text.Length];
+            input[0] = (byte)'s';
+            text.CopyTo(input, 4);
+            return BinaryPrimitives.ReadInt32LittleEndian(Md4(input));
+        }
+
+        /// <summary>RFC 1320.</summary>
+        public static byte[] Md4(byte[] message)
+        {
+            long bitLength = (long)message.Length * 8;
+            int padded = ((message.Length + 8) / 64 + 1) * 64;
+            var data = new byte[padded];
+            message.CopyTo(data, 0);
+            data[message.Length] = 0x80;
+            BinaryPrimitives.WriteInt64LittleEndian(data.AsSpan(padded - 8), bitLength);
+
+            uint a = 0x67452301, b = 0xefcdab89, c = 0x98badcfe, d = 0x10325476;
+            var x = new uint[16];
+            for (int block = 0; block < padded; block += 64)
+            {
+                for (int i = 0; i < 16; i++) x[i] = BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan(block + i * 4));
+                uint aa = a, bb = b, cc = c, dd = d;
+
+                static uint Rol(uint v, int s) => (v << s) | (v >> (32 - s));
+                static uint F(uint p, uint q, uint r) => (p & q) | (~p & r);
+                static uint G(uint p, uint q, uint r) => (p & q) | (p & r) | (q & r);
+                static uint H(uint p, uint q, uint r) => p ^ q ^ r;
+
+                foreach (int i in new[] { 0, 4, 8, 12 })
+                {
+                    a = Rol(a + F(b, c, d) + x[i], 3);
+                    d = Rol(d + F(a, b, c) + x[i + 1], 7);
+                    c = Rol(c + F(d, a, b) + x[i + 2], 11);
+                    b = Rol(b + F(c, d, a) + x[i + 3], 19);
+                }
+                foreach (int i in new[] { 0, 1, 2, 3 })
+                {
+                    a = Rol(a + G(b, c, d) + x[i] + 0x5a827999, 3);
+                    d = Rol(d + G(a, b, c) + x[i + 4] + 0x5a827999, 5);
+                    c = Rol(c + G(d, a, b) + x[i + 8] + 0x5a827999, 9);
+                    b = Rol(b + G(c, d, a) + x[i + 12] + 0x5a827999, 13);
+                }
+                foreach (int i in new[] { 0, 2, 1, 3 })
+                {
+                    a = Rol(a + H(b, c, d) + x[i] + 0x6ed9eba1, 3);
+                    d = Rol(d + H(a, b, c) + x[i + 8] + 0x6ed9eba1, 9);
+                    c = Rol(c + H(d, a, b) + x[i + 4] + 0x6ed9eba1, 11);
+                    b = Rol(b + H(c, d, a) + x[i + 12] + 0x6ed9eba1, 15);
+                }
+
+                a += aa; b += bb; c += cc; d += dd;
+            }
+
+            var digest = new byte[16];
+            BinaryPrimitives.WriteUInt32LittleEndian(digest.AsSpan(0), a);
+            BinaryPrimitives.WriteUInt32LittleEndian(digest.AsSpan(4), b);
+            BinaryPrimitives.WriteUInt32LittleEndian(digest.AsSpan(8), c);
+            BinaryPrimitives.WriteUInt32LittleEndian(digest.AsSpan(12), d);
+            return digest;
+        }
+    }
+}
