--- /dev/null
+++ b/Engine/Core/Compat/AudioVideoTypes.cs
@@ -0,0 +1,20 @@
+// Types of Unity 6 that MiniUnity had no use for, but that a serialized field can be declared as: without them the
+// field's declaring type does not load, and every field of it reads as missing.
+namespace UnityEngine.Audio
+{
+    /// <summary>Unity 6: the base of AudioClip and of the audio random container; a field of this type holds either.</summary>
+    public abstract class AudioResource : UnityEngine.Object { }
+}
+
+namespace UnityEngine.Video
+{
+    public sealed class VideoClip : UnityEngine.Object
+    {
+        public string originalPath => "";
+        public ulong frameCount => 0;
+        public double frameRate => 0;
+        public double length => 0;
+        public uint width => 0;
+        public uint height => 0;
+    }
+}
